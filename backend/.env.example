# Development-only values. Copy to backend/.env and replace every password.
POSTGRES_DB=madini
POSTGRES_USER=madini
POSTGRES_PASSWORD=replace-with-a-random-alphanumeric-value
JWT_SECRET=replace-with-at-least-32-random-bytes
TOKEN_TTL_SECONDS=43200
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
LOG_LEVEL=INFO
APP_ENV=development
API_PUBLIC_URL=http://localhost:8000
