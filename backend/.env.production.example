# Copy to .env.production outside Git. Store actual values in a secret manager.
DATABASE_URL=postgresql://API_USER:PASSWORD@DB_HOST:5432/DB_NAME?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql://MIGRATION_USER:PASSWORD@DB_HOST:5432/DB_NAME?sslmode=verify-full
JWT_SECRET=replace-with-at-least-32-random-bytes
API_PUBLIC_URL=https://api.example.tz
API_DOMAIN=api.example.tz
TOKEN_TTL_SECONDS=3600
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
LOG_LEVEL=INFO
